#!/bin/bash
# Post-installation script for cvedix-ai-runtime

set -e

# Create cvedix user and group if they don't exist
if ! getent group cvedix >/dev/null 2>&1; then
    echo "Creating cvedix group..."
    groupadd --system cvedix
fi

if ! getent passwd cvedix >/dev/null 2>&1; then
    echo "Creating cvedix user..."
    useradd --system --gid cvedix --home-dir /opt/cvedix --shell /bin/bash cvedix || true
fi

# Create necessary directories
mkdir -p /opt/cvedix
mkdir -p /etc/cvedix
mkdir -p /var/log/cvedix

# Set ownership
chown -R cvedix:cvedix /opt/cvedix
chown -R cvedix:cvedix /var/log/cvedix

# Copy example config if it doesn't exist
if [ ! -f /etc/cvedix/service.conf ]; then
    if [ -f /etc/cvedix/service.conf.example ]; then
        cp /etc/cvedix/service.conf.example /etc/cvedix/service.conf
        chmod 640 /etc/cvedix/service.conf
        chown root:cvedix /etc/cvedix/service.conf
        echo "Created /etc/cvedix/service.conf from example. Please edit it to configure your service."
    fi
fi

# Make service wrapper executable
chmod +x /usr/bin/cvedix-service-wrapper

# Reload systemd daemon
systemctl daemon-reload

# Check if service should be enabled
if [ "$1" = "configure" ]; then
    echo ""
    echo "=========================================="
    echo "CVEDIX AI Runtime Service installed"
    echo "=========================================="
    echo ""
    echo "To start the service:"
    echo "  sudo systemctl start cvedix-ai-runtime"
    echo ""
    echo "To enable the service to start on boot:"
    echo "  sudo systemctl enable cvedix-ai-runtime"
    echo ""
    echo "To check service status:"
    echo "  sudo systemctl status cvedix-ai-runtime"
    echo ""
    echo "To view service logs:"
    echo "  sudo journalctl -u cvedix-ai-runtime -f"
    echo ""
    echo "Configuration file: /etc/cvedix/service.conf"
    echo "Please edit this file to configure which sample to run."
    echo ""
fi

# DEBHELPER#
exit 0

