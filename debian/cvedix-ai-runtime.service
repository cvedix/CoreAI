[Unit]
Description=CVEDIX AI Runtime Service
Documentation=https://github.com/cvedix/core_ai_runtime
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=cvedix
Group=cvedix
WorkingDirectory=/opt/cvedix
ExecStart=/usr/bin/cvedix-service-wrapper
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cvedix-ai-runtime

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cvedix /var/log/cvedix /tmp

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Environment variables
Environment="LD_LIBRARY_PATH=/usr/lib:/opt/cvedix/lib"
Environment="GST_PLUGIN_PATH=/usr/lib/x86_64-linux-gnu/gstreamer-1.0:/usr/lib/aarch64-linux-gnu/gstreamer-1.0"

[Install]
WantedBy=multi-user.target

